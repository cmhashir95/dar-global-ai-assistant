# Copy this file to .env and fill in your own values.

# --- LLM provider ---
# The assistant uses OpenAI's chat completions API for generation, intent
# classification (structured output) and slot-extraction. Swap MODEL_* for
# any OpenAI-compatible endpoint (Azure OpenAI, Groq, local vLLM, etc).
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODE=local          # "local" (sentence-transformers, free/offline) or "openai"
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=sqlite:///./dar_global.db
VECTOR_DB_DIR=./chroma_store

# --- Guardrails ---
MAX_TURNS_BEFORE_HUMAN_HANDOFF=12
ALLOWED_TOPIC_LABEL=dar_global_real_estate
